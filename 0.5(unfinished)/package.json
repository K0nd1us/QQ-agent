{
  "name": "qq-agent",
  "version": "0.5.0",
  "description": "QQ Agent 0.5 —— DSH 薄内核 + 全插件架构（行为等价 0.4，实现从零）",
  "type": "module",
  "main": "electron/accounts-main.js",
  "license": "MIT",
  "author": "QQ Agent contributors",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "privacy:check": "node scripts/audit-privacy.mjs",
    "server": "node src/server.js",
    "desktop": "electron .",
    "build": "electron-builder --win nsis",
    "build:dir": "electron-builder --dir",
    "test": "node test/run-all.mjs",
    "test:m3": "node test/run-m3.mjs",
    "test:m4": "node test/run-m4.mjs",
    "smoke": "node scripts/smoke-headless.mjs",
    "verify:preview": "node scripts/verify-preview-build.mjs",
    "shot:ui": "node scripts/shot-ui.mjs",
    "extension:check": "node scripts/extension-dev.mjs check",
    "extension:test": "node scripts/extension-dev.mjs test",
    "extension:pack": "node scripts/extension-dev.mjs pack",
    "desktop:single": "electron electron/main.js",
    "server:accounts": "node src/accounts/server.js",
    "test:accounts": "node test/accounts-registry-test.mjs && node test/accounts-supervisor-test.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.0"
  },
  "build": {
    "appId": "cn.kondius.qq-agent",
    "productName": "QQ Agent",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "ui/**/*",
      "bundled/**/*",
      "assets/**/*",
      "scripts/inspect-composition.mjs",
      "scripts/extension-dev.mjs",
      "scripts/extension-dev.cmd",
      "scripts/lib/**/*",
      "docs/plugin-sdk.md",
      "docs/architecture-composition.md",
      "docs/extension-authoring.md",
      "docs/extension-reference.md",
      "docs/v04-extension-parity.md",
      "docs/ai-extension-prompt.md",
      "docs/ai-extension-validation.md",
      "examples/extensions/**/*",
      "package.json",
      "!data/**",
      "!data-*/*",
      "!data-*/*/**",
      "!log/**",
      "!logs/**",
      "!dist/**",
      "!node_modules/**",
      "!**/*.log"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
